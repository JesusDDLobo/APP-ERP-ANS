<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".HotelActivity">


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-180dp"
        android:layout_marginStart="-270dp"
        android:src="@drawable/square"/>


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-300dp"
        android:layout_marginEnd="-220dp"
        android:src="@drawable/square"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-270dp"
        android:layout_marginEnd="-180dp"
        android:src="@drawable/square"/>

    <include
        android:id="@+id/navbar"
        layout="@layout/layout_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navbar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:paddingHorizontal="30dp">
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"

                android:text="Hotel Asignado"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="179dp"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="20dp"
                >

                <ImageButton
                    android:padding="50dp"
                    android:layout_gravity="center"
                    android:background="@color/ans_gray_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hotel"
                    android:scaleType="centerInside"/>

            </androidx.cardview.widget.CardView>

            <GridLayout
                android:layout_gravity="center"
                android:columnCount="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Nombre"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/ans_primary_dark"
                    android:textAlignment="textStart"
                    android:layout_width="match_parent"/>
                <TextView
                    android:id="@+id/hotel_name"
                    android:text="Nombre del hotel"
                    android:textSize="15sp"
                    android:textAlignment="textStart"
                    android:textColor="@color/ans_gray_3"
                    android:layout_width="match_parent"/>


            </GridLayout>
            <GridLayout
                android:layout_gravity="center"
                android:columnCount="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Dirección"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/ans_primary_dark"
                    android:textAlignment="textStart"
                    android:layout_width="match_parent"/>
                <TextView
                    android:id="@+id/hotel_address"
                    android:text="Dirección del hotel"
                    android:textSize="15sp"
                    android:textAlignment="textStart"
                    android:textColor="@color/ans_gray_3"
                    android:layout_width="match_parent"/>


            </GridLayout>
            <GridLayout
                android:layout_gravity="center"
                android:columnCount="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Correo electrónico"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/ans_primary_dark"
                    android:textAlignment="textStart"
                    android:layout_width="match_parent"/>
                <TextView
                    android:id="@+id/hotel_email"
                    android:text="Correo electrónico del hotel"
                    android:textSize="15sp"
                    android:textAlignment="textStart"
                    android:textColor="@color/ans_gray_3"
                    android:layout_width="match_parent"/>


            </GridLayout>
            <GridLayout
                android:layout_gravity="center"
                android:columnCount="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Número de teléfono"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/ans_primary_dark"
                    android:textAlignment="textStart"
                    android:layout_width="match_parent"/>
                <TextView
                    android:id="@+id/hotel_phone"
                    android:text="Número de teléfono del hotel"
                    android:textSize="15sp"
                    android:textAlignment="textStart"
                    android:textColor="@color/ans_gray_3"
                    android:layout_width="match_parent"/>


            </GridLayout>
            <GridLayout
                android:layout_gravity="center"
                android:columnCount="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Observaciones"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/ans_primary_dark"
                    android:textAlignment="textStart"
                    android:layout_width="match_parent"/>
                <TextView
                    android:id="@+id/hotel_notes"
                    android:text="Observaciones del hotel"
                    android:textSize="15sp"
                    android:textAlignment="textStart"
                    android:textColor="@color/ans_gray_3"
                    android:layout_width="match_parent"/>


            </GridLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/download_arrow"
                    android:text="Factura electrónica"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAlignment="textStart"
                    android:textColor="@color/ans_primary"/>
                <ImageButton
                    android:id="@+id/download_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:src="@drawable/download_arrow"
                    android:background="@color/transparent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="179dp"
                android:layout_marginTop="15dp"
                app:cardCornerRadius="20dp"
                >

                <ImageButton
                    android:padding="50dp"
                    android:layout_gravity="center"
                    android:background="@color/ans_gray_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/missing"
                    android:scaleType="fitCenter"/>

            </androidx.cardview.widget.CardView>


        </GridLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>