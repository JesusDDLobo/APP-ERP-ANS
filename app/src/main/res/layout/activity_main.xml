<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".MainActivity">

    <View
        android:id="@+id/header_background"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@color/dashboard_navbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/navbar"
        layout="@layout/layout_navbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/header_background"
        app:layout_constraintStart_toStartOf="@id/header_background"
        app:layout_constraintTop_toTopOf="@id/header_background" />

    <LinearLayout
        android:id="@+id/password_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/ans_yellow"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_background">

        <TextView
            android:id="@+id/password_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Debes actualizar tu contraseña"
            android:textStyle="bold" />

        <Button
            android:id="@+id/password_banner_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/google_status_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/ans_secondary"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/password_banner">

        <TextView
            android:id="@+id/google_status_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servicios de Google no disponibles"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/google_status_acknowledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Entendido"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/dashboard_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/google_status_banner">

        <GridLayout
            android:id="@+id/sections_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <!-- TAREAS -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/dashboard_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardBackgroundColor="@color/dashboard_primary"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageButton
                            android:id="@+id/tasks_button"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Abrir tareas"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/tasks"
                            app:tint="@android:color/white" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tareas"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- VEHICULO -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardBackgroundColor="@color/dashboard_primary"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageButton
                            android:id="@+id/vehicle_button"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Abrir vehículo"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/vehicle"
                            app:tint="@android:color/white" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Vehículo"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- HOTEL -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/dashboard_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardBackgroundColor="@color/dashboard_primary"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageButton
                            android:id="@+id/hotel_button"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Abrir hotel"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/hotel"
                            app:tint="@android:color/white" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Hotel"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RENDICIONES -->
            <androidx.cardview.widget.CardView
                android:id="@+id/renditions_card"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardBackgroundColor="@color/dashboard_primary"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageButton
                            android:id="@+id/renditions_button"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Abrir rendiciones"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/rendiciones"
                            app:tint="@android:color/white" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Rendiciones"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>