<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F3F4F6"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_sub_work_order_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suborden"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sub_work_order_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Lista de tareas relacionadas"
        android:textColor="#666666"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progress_sub_work_order_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_empty_sub_work_order_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:text="No hay tareas relacionadas a esta suborden."
        android:textColor="#7A7A7A"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_sub_work_order_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>