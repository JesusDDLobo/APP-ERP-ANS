<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/field_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ans_primary_dark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        tools:text="Título del Campo"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/field_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ans_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:text="Descripción o ayuda para el conductor"
        tools:visibility="visible"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_input_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/field_input_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Respuesta" />
    </com.google.android.material.textfield.TextInputLayout>

    <Spinner
        android:id="@+id/field_input_select"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_spinner"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/field_input_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_select_image"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar Imagen"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/selected_image_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="No seleccionado"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ans_secondary"/>
    </LinearLayout>
</LinearLayout>

